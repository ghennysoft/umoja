// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  photo     String?
  role      UserRole @default(MEMBER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  members       Member[]       
  contributions Contribution[] 
  agents        Agent[]        
  auditLogs     AuditLog[]    
}

model Agent {
  id             String        @id @default(cuid())
  agentId        String        @unique
  firstName      String
  lastName       String
  postName       String?
  photo          String?
  birthDate      DateTime
  birthPlace     String
  gender         Gender
  nationality    String
  provinceOrigin String
  maritalStatus  MaritalStatus
  country        String
  city           String
  commune        String
  address        String
  phone          String
  whatsapp       String?
  email          String?

  // Identification
  hasId            Boolean   @default(false)
  idType           IdType?
  idNumber         String?
  idExpirationDate DateTime?
  idPhoto          String?

  // Function
  function   String
  zone       String
  startDate  DateTime
  supervisor String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ownerId String?
  userId  String?
  user    User?    @relation(fields: [userId], references: [id])
}

model Member {
  id             String        @id @default(cuid())
  memberId       String        @unique
  firstName      String
  lastName       String
  postName       String?
  photo          String?
  birthDate      DateTime
  birthPlace     String
  gender         Gender
  nationality    String
  provinceOrigin String
  maritalStatus  MaritalStatus
  country        String
  city           String
  commune        String
  address        String
  phone          String
  whatsapp       String?
  email          String?

  hasDiploma   Boolean       @default(false)
  diplomaLevel DiplomaLevel?
  profession   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId       String?
  userId        String?
  user          User?          @relation(fields: [userId], references: [id])
  contributions Contribution[]
}

model Contribution {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  amount    Decimal            @db.Decimal(18, 2)
  currency  String             @default("CDF")
  status    ContributionStatus @default(PENDING)

  // Référence unique envoyée à MaishaPay (originatingTransactionId)
  transactionReference String             @unique

  createdAt            DateTime           @default(now())
  paidAt               DateTime?
  transactions         Transaction[]
}

model Transaction {
  id                        String             @id @default(cuid())
  contributionId            String
  contribution              Contribution       @relation(fields: [contributionId], references: [id])

  transactionReference      String             @unique
  maishaTransactionId       Int?               // "transactionId" renvoyé par MaishaPay
  originatingTransactionId  String?            // ta référence

  status                    ContributionStatus @default(PENDING)
  statusCode                Int?
  amount                    Decimal            @db.Decimal(18, 2)
  fees                      Decimal?           @db.Decimal(18, 2)
  total                     Decimal?           @db.Decimal(18, 2)
  currency                  String
  channel                   String             // MOBILEMONEY
  provider                  String             // AIRTEL / ORANGE / MTN ...
  walletID                  String

  rawInitResponse           String?            // JSON.stringify de la réponse d'init
  rawCallback               String?            // JSON.stringify du callback

  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String // CREATE, UPDATE, DELETE, LOGIN, LOGOUT
  entity    String // USER, MEMBER, AGENT, CONTRIBUTION
  entityId  String?
  changes   Json? // Changements effectués
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  MARRIED
  SINGLE
  WIDOWED
  DIVORCED
}

enum DiplomaLevel {
  STATE_DIPLOMA
  GRADUATE
  LICENSE
  MASTER
  DOCTORATE
}

enum UserRole {
  ADMIN
  AGENT
  MEMBER
}

enum IdType {
  NATIONAL_ID
  PASSPORT
  DRIVER_LICENSE
  OTHER
}

enum ContributionStatus {
  PENDING
  SUCCESS
  FAILED
}
